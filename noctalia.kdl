layout {

    focus-ring {
        active-color   "#a1c9fd"
        inactive-color "#111418"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#a1c9fd"
        inactive-color "#111418"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#a1c9fd"
        inactive-color "#1b4975"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#a1c9fd80"
    }
}

recent-windows {
    highlight {
        active-color "#a1c9fd"
        urgent-color "#ffb4ab"
    }
}
