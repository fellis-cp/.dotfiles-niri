workspace "dly" //1
workspace "wrk" //2
workspace "scratchpad" //

window-rule {
    clip-to-geometry true
    open-maximized true
    open-focused true
    background-effect {
        blur false
    }
    draw-border-with-background false 
}

layer-rule {
    match namespace="^noctalia-wallpaper*"
    place-within-backdrop true
}

window-rule {
    match app-id="vlc"
    open-maximized false
    open-focused true
}

window-rule {
    match app-id="code"
    open-maximized true
    open-focused true
    opacity 0.9
    background-effect {
        blur true
    }
}

window-rule {
    match app-id="discord"
    open-maximized true
    open-on-workspace "scratchpad"
    open-focused true
}

window-rule {
    match app-id="google-chrome"
    open-maximized true
    open-focused true
    draw-border-with-background true
}

window-rule {
    match app-id="kitty"
    open-maximized true
    opacity 0.9
    background-effect {
        blur true
    }
    draw-border-with-background false    
}

window-rule {
    match app-id="steam"
    open-floating false
    open-focused false
}

window-rule {
    match app-id="heroic"
    open-maximized true
    open-focused true
}

window-rule {
    match app-id="Spotify"
    open-maximized true
    open-on-workspace "scratchpad"
    open-focused false
    opacity 0.9
}

window-rule {
    match app-id="GitHub Desktop"
    opacity 0.97
}

window-rule {
    match app-id="antigravity"
    background-effect {
        blur true
    }
}

window-rule {
    match app-id="cursor"
    background-effect {
        blur true
    }
}

window-rule {
    match app-id="python3"
    open-focused false
    open-maximized true
}

window-rule {
    match app-id="dolphin"
    opacity 0.8
    background-effect {
        blur true
    }
}

window-rule {
    match app-id="kate"
    opacity 0.93
    open-maximized false
    background-effect {
        blur true
    } 
}

window-rule {
    match app-id="org.kde.plasma-systemmonitor"
    opacity 0.8
    open-maximized true
    background-effect {
        blur true
    } 
}

window-rule {
    match title="Konsole"
    open-floating false
    open-maximized true
    opacity 0.74
    background-effect{
        blur true
    }
}


window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
} 

window-rule {
    match app-id="Zoom Workplace" title=".*menu.*"
    open-floating true
    min-width 250
    open-focused true
} 

window-rule {
    match app-id="^steam_app_default$"
    open-floating true
}

window-rule {
    match app-id="Free Download Manager"
    open-floating true
}